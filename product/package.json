{
  "name": "oracle-trading-system",
  "version": "1.2.9",
  "description": "Oracle Trading System — NQ/ES algorithmic trading engine for TopstepX",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "DEV_LICENSE=1 electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win",
    "bundle": "node_modules/.bin/esbuild ../engine/topstepx-engine.js --bundle --platform=node --format=esm --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --outfile=dist-engine/topstepx-engine.js && node scripts/patch-bundle.mjs",
    "release:mac": "npm run bundle && electron-builder --mac --publish=always",
    "release:win": "npm run bundle && electron-builder --win --publish=always",
    "release:all": "npm run bundle && electron-builder --mac --win --publish=always"
  },
  "dependencies": {
    "@microsoft/signalr": "^8.0.0",
    "axios": "^1.7.0",
    "electron-updater": "^6.8.9",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "esbuild": "^0.28.1"
  },
  "build": {
    "appId": "com.oracletradingsystem.app",
    "productName": "Oracle Trading System",
    "files": [
      "electron/**/*",
      "src/**/*",
      "config.default.json",
      "README.txt"
    ],
    "extraResources": [
      {
        "from": "dist-engine",
        "to": "engine",
        "filter": [
          "topstepx-engine.js",
          "alpaca-engine.js"
        ]
      },
      {
        "from": "../engine/package.json",
        "to": "engine/package.json"
      },
      {
        "from": "../node_modules/ws",
        "to": "engine/node_modules/ws"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "NigelAi1140",
      "repo": "es-futures-bot",
      "releaseType": "draft"
    },
    "mac": {
      "category": "public.app-category.finance",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "installerLanguages": [
        "en_US"
      ],
      "deleteAppDataOnUninstall": false
    }
  }
}
