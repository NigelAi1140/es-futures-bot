# ─── Interactive Brokers TWS Connection ──────────────────────────────────────
# TWS or IB Gateway must be running on your machine before the bot starts.
# Enable API in TWS: Edit → Global Configuration → API → Settings
#   ✅ Enable ActiveX and Socket Clients
#   ✅ Socket port = 7497 (paper) or 7496 (live)
#   ✅ Allow connections from localhost only (safer)

TWS_HOST=127.0.0.1
TWS_PORT=7497          # 7497 = TWS Paper Trading | 7496 = TWS Live | 4002 = IB Gateway Paper
TWS_CLIENT_ID=1

# ─── What to trade ────────────────────────────────────────────────────────────
SYMBOL=ES              # E-mini S&P 500 futures
EXCHANGE=CME
CURRENCY=USD
CONTRACT_EXPIRY=       # Leave blank for front-month auto-detect, or set e.g. 20250620
TIMEFRAME=5m           # 1m, 5m, 15m, 1H, 4H

# ─── Risk Management ──────────────────────────────────────────────────────────
# ES tick = $12.50. 1 contract = 50x the index.
# Example: 8 stop ticks = $100 risk | 16 profit ticks = $200 reward (2:1 R:R)
PORTFOLIO_VALUE_USD=10000
MAX_TRADE_SIZE_USD=500
MAX_TRADES_PER_DAY=2
STOP_LOSS_TICKS=8      # Number of 0.25-point ticks for stop loss
TAKE_PROFIT_TICKS=16   # Number of 0.25-point ticks for take profit (2:1 R:R)

# ─── Mode ─────────────────────────────────────────────────────────────────────
PAPER_TRADING=true     # Set to false ONLY after validating with paper trades
